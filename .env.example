# OpenSeat の環境変数。実際の値は .env に書く（.env はコミットしない）。

# サーバ
PORT=8080
NODE_ENV=development
# 画面に出す版。Railway では ${{RAILWAY_GIT_COMMIT_SHA}} を入れる。
GIT_SHA=dev

# 施設。**複数施設は 9.6 の想定で、いまは 1 つだけを起こす。**
VENUE_ID=demo
VENUE_NAME=OpenSeat
# その施設がまだ無いときだけ、この数だけ席を作る。席の一覧編集は PR 13。
SEED_TABLES=0
# 作った施設を、そのまま運用中にするか。運用の開始と終了は PR 14 で入る。
SEED_OPEN=false

# データベース（SQLite のファイルパス）。コンテナではボリュームの中を指す。
DB_PATH=./data/openseat.db
# マイグレーションの置き場。実行時の作業ディレクトリからの相対。
MIGRATIONS_DIR=db/migrations

# セッションの署名鍵。本番では十分な長さのランダム値に置き換えること。
SESSION_SECRET=change-me-in-production

# Web Push（VAPID）。`npx web-push generate-vapid-keys` で生成する。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# LINE 通知（任意。施設が有効化した場合のみ）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# バックアップ（Litestream。S3 互換ストレージ）
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
