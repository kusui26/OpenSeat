# OpenSeat の環境変数。実際の値は .env に書く（.env はコミットしない）。

# サーバ
PORT=3000
NODE_ENV=development

# データベース（SQLite のファイルパス）
DATABASE_URL=file:./data/openseat.db

# セッションの署名鍵。本番では十分な長さのランダム値に置き換えること。
SESSION_SECRET=change-me-in-production

# Web Push（VAPID）。`npx web-push generate-vapid-keys` で生成する。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# LINE 通知（任意。施設が有効化した場合のみ）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# バックアップ（Litestream。S3 互換ストレージ）
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
