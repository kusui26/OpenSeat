{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // `rootDir` は置かない。**何も出さないので要らず**、置くと「元のソースが
    // 外にある」と言って落ちる（下の `paths` で外を見ている）。
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,

    // ここは境界である。サーバを起こし、ファイルを開き、プロセスの合図を受ける。
    "types": ["node"],

    // **Node がそのまま走らせる**（22 の型剥がし）。だから拡張子まで書く。
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,

    // **走らせるのは組み上がり、型を引くのは元のソース。**
    //
    // ハーネスはサーバの `dist` を読み込む —— 元のソースには、Node の型剥がしが
    // 扱えない書き方（コンストラクタの引数プロパティ）が含まれるためである。
    // ただし `dist` は組み立てないと存在しないので、**そのままだと綺麗な
    // チェックアウトで型が引けず、lint が「型が分からない」と言って落ちる。**
    // 中身は同じものなので、型はソースから引く。
    "paths": {
      "@openseat/server/dist/*": ["../apps/server/*"]
    }
  },

  // **置き場所を数え上げない**（`apps/server/tsconfig.json` と同じ理由）。
  "include": ["**/*.ts"],
  "exclude": ["test-results", "playwright-report"]
}
