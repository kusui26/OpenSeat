{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,

    // ここは境界である。`process`・`node:*`・HTTP・SQLite に触ってよい層で、
    // だから Node の型を入れる（`packages/core` は依存ゼロのまま）。
    "types": ["node"]
  },

  // **テストも型検査に含める。** 外れていると、型の合わないテストが
  // 「走るけれど検査されない」状態になる（`pnpm typecheck` が見る）。
  "include": ["src/**/*.ts", "db/**/*.ts", "venue/**/*.ts"],

  // **使うものだけを参照する。** コンテナが写すものと揃えること（`infra/Dockerfile`）。
  // 使っていないものを参照すると、組み立てがファイルを見つけられずに落ちる。
  "references": [{ "path": "../../packages/core/tsconfig.build.json" }]
}
