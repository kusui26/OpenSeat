        },
        "end_reason_is_declared": {
          "name": "end_reason_is_declared",
          "value": "end_reason IS NULL OR end_reason IN ('checked_out', 'staff_checkout', 'auto_release', 'user_cancel', 'staff_cancel', 'venue_closed', 'no_show', 'abandoned', 'pause_expired', 'max_age')"
        },
        "assigned_has_table": {
          "name": "assigned_has_table",
          "value": "(NOT (state IN ('CALLED', 'SEATED')) OR (table_id IS NOT NULL))"
        },
        "terminal_holds_no_table": {
          "name": "terminal_holds_no_table",
          "value": "(NOT (state IN ('DONE', 'CANCELLED', 'NO_SHOW', 'EXPIRED')) OR (table_id IS NULL))"
        },
        "held_table_has_deadline": {
          "name": "held_table_has_deadline",
          "value": "(NOT (state = 'CALLED') OR (hold_deadline IS NOT NULL AND called_at IS NOT NULL))"
        },
        "state_timestamps_are_set": {
          "name": "state_timestamps_are_set",
          "value": "(NOT (state = 'SEATED') OR (seated_at IS NOT NULL)) AND (NOT (state = 'PAUSED') OR (pause_deadline IS NOT NULL AND paused_since IS NOT NULL)) AND (NOT (state IN ('DONE', 'CANCELLED', 'NO_SHOW', 'EXPIRED')) OR (ended_at IS NOT NULL AND end_reason IS NOT NULL))"
        },
        "notices_are_scoped": {
          "name": "notices_are_scoped",
          "value": "(NOT (state <> 'PAUSED') OR (paused_since IS NULL)) AND (NOT (state <> 'CALLED') OR (hold_reminded_at IS NULL)) AND (NOT (state <> 'SEATED') OR (still_here_asked_at IS NULL AND still_here_answered_at IS NULL AND time_limit_noticed_at IS NULL))"
        },
