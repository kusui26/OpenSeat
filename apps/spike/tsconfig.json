{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "composite": true,

    // ここは境界である。`process`・`node:sqlite`・HTTP に触ってよい唯一の層で、
    // だから Node の型を入れる（`packages/core` は依存ゼロのまま）。
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../../packages/core/tsconfig.build.json" }]
}
